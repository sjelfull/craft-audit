{% extends "_layouts/cp" %}

{% do view.registerAssetBundle("superbig\\audit\\assetbundles\\audit\\AuditAsset") %}
{% do view.registerAssetBundle("superbig\\audit\\assetbundles\\indexcpsection\\IndexCPSectionAsset") %}
{% do view.registerAssetBundle("superbig\\audit\\web\\assets\\diff\\AuditDiffAsset") %}

{% do view.registerTranslations('audit', ['From', 'To']) %}

{% set title = "Audit"|t('audit') %}

{% block actionButton %}
    {% if currentUser.can('audit-clear-logs') %}
        <div class="buttons">
            <a href="{{ url('audit/prune-logs') }}" class="btn submit icon">{{ "Prune old records"|t('audit') }}</a>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {% include "audit/_filters" %}
    <div id="audit-results" aria-live="polite">
        {% include "audit/_results" %}
    </div>
{% endblock %}
