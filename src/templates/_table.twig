{#
 # The log table. Batch parents carry `audit-batch-parent` and a toggle; their children follow as
 # hidden `audit-child-row` rows in the same tbody (one level deep, deeper trees are in the detail view).
 #
 # Expects:
 #   - logs: AuditModel[]
 #}

{% import _self as table %}

{% macro row(log, attrs = {}, eventPrefix = '', meta = null) %}
    {% set element = log.getElement() %}
    {% set user = log.getUser() %}
    {% set fieldMap = log.getFieldMap() %}
    {% set changed = fieldMap|map(f => f.name) %}
    <tr {{ attr({
        'data-audit-log': log.id,
        class: ['audit-row'],
    }|merge(attrs, true)) }}>
        <td class="audit-cell--event">
            {{ eventPrefix|raw }}
            <a href="{{ log.getCpEditUrl() }}" class="audit-event audit-event--{{ log.getTone() }}" data-audit-open>{{ log.getEventLabel() }}</a>
        </td>
        <td class="audit-cell--item">
            <div class="audit-item">
                {% if element %}
                    {{ elementChip(element, { showStatus: false, attributes: { class: ['chromeless'] } }) }}
                {% elseif log.title %}
                    <span class="audit-item__title">{{ log.displayTitle }}</span>
                {% else %}
                    <span class="light" aria-hidden="true">–</span>
                {% endif %}
                <div class="audit-item__meta smalltext light">
                    {%- if meta is not null -%}
                        {{ meta }}
                    {%- else -%}
                        {{- log.getElementLabel() -}}
                        {%- if changed|length %} · {{ changed|slice(0, 3)|join(', ') }}{% if changed|length > 3 %} {{ '+{count} more'|t('audit', { count: changed|length - 3 }) }}{% endif %}{% endif -%}
                    {%- endif -%}
                </div>
            </div>
        </td>
        <td class="audit-cell--user">
            {% if user %}
                {{ elementChip(user, { showStatus: false, attributes: { class: ['chromeless'] } }) }}
                {% if log.impersonatorId and log.getImpersonator() %}
                    <div class="smalltext light">{{ 'via {name}'|t('audit', { name: log.getImpersonator().fullName ?: log.getImpersonator().username }) }}</div>
                {% endif %}
            {% else %}
                <span class="light">{{ 'Guest or system'|t('audit') }}</span>
            {% endif %}
            {% if log.ip %}<div class="smalltext light code">{{ log.ip }}</div>{% endif %}
        </td>
        <td class="audit-cell--site">{{ log.getSite().name ?? '' }}</td>
        <td class="audit-cell--date">
            <time datetime="{{ log.dateCreated|atom }}" title="{{ log.getFormattedDate('medium') }}">{{ log.getRelativeDate() }}</time>
        </td>
        <td class="thin audit-cell--open">
            <a href="{{ log.getCpEditUrl() }}" class="audit-open" data-audit-open aria-label="{{ 'View details'|t('audit') }}" title="{{ 'View details'|t('audit') }}">
                <span class="cp-icon small" aria-hidden="true">{{ iconSvg('chevron-right') }}</span>
            </a>
        </td>
    </tr>
{% endmacro %}

<div class="tableview audit-table-wrapper">
    <table class="data fullwidth audit-table">
        <thead>
        <tr>
            <th scope="col">{{ 'Event'|t('audit') }}</th>
            <th scope="col">{{ 'Item'|t('audit') }}</th>
            <th scope="col">{{ 'User'|t('app') }}</th>
            <th scope="col">{{ 'Site'|t('app') }}</th>
            <th scope="col">{{ 'When'|t('audit') }}</th>
            <th scope="col" class="thin"><span class="visually-hidden">{{ 'Details'|t('audit') }}</span></th>
        </tr>
        </thead>
        <tbody>
        {% for log in logs %}
            {% if log.getIsBatch() and not log.parentId %}
                {% set snapshot = log.snapshot ?? {} %}
                {% set state = snapshot.state ?? 'running' %}
                {% set children = log.children ?? [] %}
                {% set effectiveCount = snapshot.childCount ?? (children|length) %}
                {% set hasChildren = effectiveCount > 0 %}
                {% set toggle %}
                    <button type="button"
                            class="audit-batch-toggle"
                            aria-expanded="false"
                            aria-controls="batch-{{ log.id }}"
                            aria-label="{{ hasChildren ? 'Expand batch'|t('audit') : 'No child rows in this batch'|t('audit') }}"
                            {% if not hasChildren %}disabled{% endif %}>
                        <svg viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M4 2 L8 6 L4 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                {% endset %}
                {% set durationMs = snapshot.durationMs ?? null %}
                {% set meta -%}
                    {%- if effectiveCount == 0 -%}
                        {{ 'No child rows in this batch'|t('audit') }}
                    {%- elseif effectiveCount == 1 -%}
                        1 {{ 'child row'|t('audit') }}
                    {%- else -%}
                        {{ effectiveCount }} {{ 'child rows'|t('audit') }}
                    {%- endif -%}
                    {%- if durationMs is not null %} · {{ (durationMs / 1000)|number_format(1) }}s{% endif -%}
                    {%- if state %} · {{ state|t('audit') }}{% endif -%}
                {%- endset %}
                {{ table.row(log, {
                    class: ['audit-batch-parent']|merge(state == 'running' ? ['audit-batch-running'] : []),
                    'data-audit-batch': log.id,
                }, toggle, meta) }}
                {% if hasChildren %}
                    {% for child in children %}
                        {{ table.row(child, { class: ['audit-child-row', 'hidden'], 'data-parent': log.id }) }}
                    {% endfor %}
                {% endif %}
            {% else %}
                {{ table.row(log) }}
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
</div>
